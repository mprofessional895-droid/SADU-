<?xml version="1.0" encoding="utf-8"?>
<!--
  The Sadu mark: a stack of glossy ribbon strokes that interleave into an S, drawn with a
  silver gradient and a soft inner bloom. Kept inside the 66dp adaptive-icon safe zone so no
  launcher mask (circle, squircle, rounded square) clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- silver bloom behind the mark -->
    <path android:pathData="M54,54 m-26,0 a26,26 0 1,0 52,0 a26,26 0 1,0 -52,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="26">
                <item android:offset="0" android:color="#2EFFFFFF" />
                <item android:offset="0.5" android:color="#12FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- the ribbon, lower stroke first so the upper one overlaps it -->
    <path
        android:pathData="M43,65 C50,71 62,71 68,64"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="34"
                android:startY="24"
                android:endX="76"
                android:endY="80">
                <item android:offset="0" android:color="#FF9AA0A6" />
                <item android:offset="0.45" android:color="#FF3A3E42" />
                <item android:offset="1" android:color="#FFE8EAEC" />
            </gradient>
        </aapt:attr>
    </path>

    <path
        android:pathData="M70,33 C70,25.5 61,21.5 52,22.5 C41,23.8 36,34 45,40.5 L63,49.5 C73,55 72,67.5 61,71"
        android:strokeWidth="9.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="34"
                android:startY="22"
                android:endX="72"
                android:endY="72">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="0.3" android:color="#FFEDEFF1" />
                <item android:offset="0.55" android:color="#FF6C7175" />
                <item android:offset="1" android:color="#FF26292C" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- specular highlight along the lit edge of the ribbon -->
    <path
        android:pathData="M67.5,31.5 C66,26 60,23 53,23.2"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeColor="#C9FFFFFF" />
    <path
        android:pathData="M46.5,38.5 C50,35.5 56,35 59.5,37"
        android:strokeWidth="1.1"
        android:strokeLineCap="round"
        android:strokeColor="#66FFFFFF" />
</vector>
